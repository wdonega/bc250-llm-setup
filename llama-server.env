# Installed to /etc/default/llama-server by 72-configure-head.sh.
#
# 72-configure-head.sh installs this only ONCE and never overwrites it, so
# your tuned values survive re-runs. After editing:
#
#   sudo systemctl restart llama-server
#
# Measured 2026-09-14 on two BC-250 boards over 2.5 GbE, 875-token prompt,
# 3000 tokens out (see section 11 of the README):
#
#   UD-Q4_K_M  + 32k  ->  16.18 t/s generation,  4.3 GB free on the head
#   UD-Q4_K_M  + 64k  ->  15.55 t/s generation,  3.2 GB free
#   UD-Q5_K_XL + 32k  ->  13.41 t/s generation,  2.0 GB free
#   UD-Q5_K_XL + 64k  ->  13.23 t/s generation,  0.9 GB free   (NOT operable)
#
# Below roughly 1.5 GB free, llama-server is in the OOM killer's sights as
# soon as the context fills. Do not raise the quant and the context together.

LLAMA_MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M
LLAMA_CTX_SIZE=65536
LLAMA_ALIAS=qwen3.8-27b-q4

# Address of the board running 71-configure-worker.sh. CHANGE THIS.
LLAMA_RPC_WORKER=llm4.lab:50052

# q8_0 is the default. q4_0 halves the KV cache, costs close to nothing in
# perceived quality, and measured 4% faster (less data crossing the network
# per token).
LLAMA_CACHE_TYPE=q8_0
